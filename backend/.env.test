# Test environment — used ONLY by `npm test` (see vitest.config.ts + tests/globalSetup.ts).
# Points Prisma at a throwaway SQLite file so the test suite never touches dev.db.
# Contains no real secrets (JWT value matches the public dev fallback in the source).
DATABASE_URL="file:./test.db"
JWT_SECRET="peoplepay360-super-secret-jwt-key-2026-hackathon"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="payslips@peoplepay360.com"
NODE_ENV="test"
