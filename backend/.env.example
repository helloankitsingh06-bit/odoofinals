# Copy to .env and fill in real values. .env is gitignored.

# Port the Express server listens on (defaults to 5001 if unset).
PORT=5001

# Email address that should be treated as the Admin user.
# Any real Firebase user signing in with this email gets role "Admin".
ADMIN_EMAIL=you@example.com

# Set to "production" on a real deployment. Leaving it unset enables mock auth.
NODE_ENV=development

# When NODE_ENV=production, mock-<Role> bearer tokens are rejected unless this
# is explicitly "true". Keep it unset/false in production.
ALLOW_MOCK_AUTH=false
