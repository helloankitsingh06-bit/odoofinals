# Copy to .env and fill in real values. .env is gitignored.

# Base URL of the backend API (no trailing slash).
VITE_API_BASE_URL=http://localhost:5001/api

# Optional: set to the same address as the backend's ADMIN_EMAIL so the UI
# shows the Admin-only menu for that account. The backend is still the
# authority on authorization.
VITE_ADMIN_EMAIL=

# Firebase Web app config — from YOUR Firebase project:
#   Firebase console > Project settings > General > Your apps
#   > SDK setup and configuration.
# These ship in the browser bundle; that's expected. Security is enforced by
# Firebase Auth + Firestore Security Rules, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
